{
  "rules": {
    "games": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && data.child('state/creator').val() === auth.uid",
        ".validate": "$code.matches(/^[A-Z]{4}$/)",
        "state": {
          ".write": "auth != null && (!data.exists() ? newData.child('creator').val() === auth.uid : (data.child('creator').val() === auth.uid || data.child('teams').child(auth.uid).exists()))",
          ".validate": "newData.hasChildren(['status', 'creator', 'budget', 'max', 'seq'])"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && root.child('games').child($code).child('state/status').val() === 'lobby' && (auth.uid === $uid || root.child('games').child($code).child('state/creator').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.hasChildren(['name', 'f']) && newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('f').isString())"
          }
        },
        "bids": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('games').child($code).child('state/phase').val() === 'bid' && root.child('games').child($code).child('state/teams').child($uid).exists() && newData.child('r').val() === root.child('games').child($code).child('state/round').val() && now <= root.child('games').child($code).child('state/cur/end').val() + 1500 && (!data.exists() || data.child('r').val() !== newData.child('r').val())",
            ".validate": "newData.hasChildren(['r', 'a', 't']) && newData.child('a').isNumber() && newData.child('a').val() >= 0 && newData.child('a').val() <= 100000"
          }
        }
      }
    },
    "ncc": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && data.child('state/creator').val() === auth.uid",
        ".validate": "$code.matches(/^[A-Z]{4}$/)",
        "state": {
          ".write": "auth != null && (!data.exists() ? newData.child('creator').val() === auth.uid : (data.child('creator').val() === auth.uid || data.child('names').child(auth.uid).exists()))",
          ".validate": "newData.hasChildren(['status', 'creator', 'max', 'seq'])"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && root.child('ncc').child($code).child('state/status').val() === 'lobby' && (auth.uid === $uid || root.child('ncc').child($code).child('state/creator').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 40)"
          }
        },
        "answers": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('ncc').child($code).child('state/names').child($uid).exists() && root.child('ncc').child($code).child('state/phase').val() === 'play' && newData.child('r').val() === root.child('ncc').child($code).child('state/round').val() && now <= root.child('ncc').child($code).child('state/end').val() + 3000",
            ".validate": "newData.hasChildren(['r']) && newData.child('r').isNumber()",
            "a": {
              "$i": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              }
            }
          }
        },
        "votes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('ncc').child($code).child('state/names').child($uid).exists() && root.child('ncc').child($code).child('state/phase').val() === 'review' && newData.child('r').val() === root.child('ncc').child($code).child('state/round').val()",
            ".validate": "newData.hasChildren(['r']) && newData.child('r').isNumber()"
          }
        }
      }
    },
    "scv": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && data.child('state/creator').val() === auth.uid",
        ".validate": "$code.matches(/^[A-Z]{4}$/)",
        "state": {
          ".write": "auth != null && (!data.exists() ? newData.child('creator').val() === auth.uid : (data.child('creator').val() === auth.uid || data.child('names').child(auth.uid).exists()))",
          ".validate": "newData.hasChildren(['status', 'creator', 'max', 'seq'])"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && root.child('scv').child($code).child('state/status').val() === 'lobby' && (auth.uid === $uid || root.child('scv').child($code).child('state/creator').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 40)"
          }
        },
        "sol": {
          ".write": "auth != null && root.child('scv').child($code).child('state/creator').val() === auth.uid"
        },
        "found": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('scv').child($code).child('state/names').child($uid).exists() && root.child('scv').child($code).child('state/phase').val() === 'play' && newData.child('r').val() === root.child('scv').child($code).child('state/round').val() && now <= root.child('scv').child($code).child('state/end').val() + 3000",
            ".validate": "newData.hasChildren(['r']) && newData.child('r').isNumber()",
            "w": {
              "$w": {
                ".validate": "$w.length <= 16 && newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
              }
            }
          }
        },
        "ready": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('scv').child($code).child('state/names').child($uid).exists()",
            ".validate": "newData.isNumber()"
          }
        }
      }
    },
    "index": {
      ".read": "auth != null",
      ".indexOn": [
        "createdAt"
      ],
      "$code": {
        ".write": "auth != null && (!data.exists() ? newData.child('creator').val() === auth.uid : (data.child('creator').val() === auth.uid || root.child('games').child($code).child('state/teams').child(auth.uid).exists() || root.child('ncc').child($code).child('state/names').child(auth.uid).exists() || root.child('scv').child($code).child('state/names').child(auth.uid).exists()))"
      }
    },
    "presence": {
      "$code": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || newData.isBoolean()"
        }
      }
    },
    "results": {
      ".read": "auth != null",
      ".indexOn": [
        "endedAt"
      ],
      "$code": {
        ".write": "auth != null && !data.exists() && ((newData.child('game').val() === 'fantabusta' && root.child('games').child($code).child('state/status').val() === 'done' && root.child('games').child($code).child('state/teams').child(auth.uid).exists()) || (newData.child('game').val() === 'ncc' && root.child('ncc').child($code).child('state/status').val() === 'done' && root.child('ncc').child($code).child('state/names').child(auth.uid).exists()) || (newData.child('game').val() === 'scv' && root.child('scv').child($code).child('state/status').val() === 'done' && root.child('scv').child($code).child('state/names').child(auth.uid).exists()))",
        ".validate": "newData.hasChildren(['game', 'endedAt', 'p'])"
      }
    },
    "users": {
      ".read": "auth != null",
      "$pid": {
        ".write": "auth != null && (auth.uid === $pid || root.child('alias').child(auth.uid).child('pid').val() === $pid)",
        ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 40"
      }
    },
    "alias": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.exists() && root.child('links').child(newData.child('code').val()).child('pid').val() === newData.child('pid').val() && root.child('links').child(newData.child('code').val()).child('exp').val() > now",
        ".validate": "newData.hasChildren(['pid', 'code']) && newData.child('code').isString()"
      }
    },
    "links": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (data.exists() ? (auth.uid === data.child('pid').val() || root.child('alias').child(auth.uid).child('pid').val() === data.child('pid').val()) : (auth.uid === newData.child('pid').val() || root.child('alias').child(auth.uid).child('pid').val() === newData.child('pid').val()))",
        ".validate": "!newData.exists() || ($code.matches(/^[A-Z0-9]{6}$/) && newData.hasChildren(['pid', 'exp']) && newData.child('exp').isNumber() && newData.child('exp').val() <= now + 900000)"
      }
    }
  }
}